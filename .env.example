# ==============================================================================
# AVENIQ AI OS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate your secret credentials.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ==============================================================================
# 1. GOOGLE GEMINI LLM ROUTER & REASONING ENGINE
# ==============================================================================
# Google AI Studio API key for Gemini LLM text generation and reasoning.
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# Primary Gemini model used for departmental strategy, reasoning, and copywriting.
GEMINI_PRIMARY_MODEL=gemini-2.5-pro

# Automatic quota-aware fallback model chain evaluated when primary model rate limits.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-2.0-flash

# Optional explicit text model override.
GEMINI_MODEL_TEXT=gemini-2.5-pro

# Optional explicit image model override for Gemini Image Provider.
GEMINI_MODEL_IMAGE=imagen-3.0-generate-002


# ==============================================================================
# 2. GOOGLE IMAGEN 3 VISUAL ASSET SYNTHESIS ENGINE
# ==============================================================================
# Optional dedicated Google Imagen API key (falls back to GEMINI_API_KEY if unset).
GOOGLE_IMAGEN_API_KEY=

# Primary model name for Google Imagen 3 image generation engine.
GOOGLE_IMAGEN_MODEL=gemini-2.5-flash-image



# ==============================================================================
# 3. TELEGRAM BOT DISPATCH & HUMAN APPROVAL NOTIFICATIONS
# ==============================================================================
# Telegram Bot API Token obtained from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Telegram Channel, Group, or Chat ID (e.g., -100xxxxxxxxxx or @your_channel).
TELEGRAM_CHAT_ID=


# ==============================================================================
# 4. MARKET INTELLIGENCE & SOCIAL DATA INGESTION
# ==============================================================================
# Reddit API credentials for market sentiment & buying intent collection.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AVENIQ/1.0

# GitHub Personal Access Token for star velocity & MCP repository tracking.
GITHUB_TOKEN=


# ==============================================================================
# 5. PLATFORM EXECUTION & WORKSPACE STORAGE
# ==============================================================================
# Application execution environment (development | staging | production).
ENVIRONMENT=development

# Relative or absolute directory path for campaign visual asset storage.
WORKSPACE_STORAGE=storage/campaigns/assets
